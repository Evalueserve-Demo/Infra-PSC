cat > .gitignore <<'EOF'
# Terraform local files
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variables
*.tfvars
*.tfvars.json

# Generated artifacts
*.zip
__pycache__/
*.pyc
build/

# Backups
*.backup
*.bak
lambda-backup/

# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*
EOF